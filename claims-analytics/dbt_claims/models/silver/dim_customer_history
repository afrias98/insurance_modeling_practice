{{ config(materialized='table', schema='silver') }}

SELECT
    customer_sk,
    customer_id,
    customer_name,
    customer_address,
    customer_city,
    customer_state,
    customer_postal,
    customer_risk_score,
    loss_date AS start_date,
    LEAD(loss_date) OVER (
        PARTITION BY customer_id ORDER BY loss_date
    ) AS end_date,
    IFF(
        LEAD(loss_date) OVER (
            PARTITION BY customer_id ORDER BY loss_date
        ) IS NULL,
        TRUE,
        FALSE
    ) AS is_active
FROM {{ ref('customer_snapshot_lad') }}
ORDER BY customer_id, start_date;